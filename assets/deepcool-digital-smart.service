[Unit]
Description=DeepCool Digital mode manager (Smart load-aware / Auto alternation)
# Enabled/disabled from deepcool-digital-gui ("Smart"/"Auto" options);
# runtime config in ~/.config/deepcool-digital-manager.env

[Service]
ExecStart=/usr/bin/deepcool-digital-smart
Environment=BUSY_PCT=50
Environment=IDLE_PCT=25
Environment=POLL_SEC=2
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target

#!/usr/bin/env python3
"""DeepCool Digital — mode manager (smart / auto).

Two modes, configured via ~/.config/deepcool-digital-manager.env
(which overrides the unit's Environment= defaults):

  MANAGER_MODE=auto    alternate Temperature <-> CPU usage every DWELL_SEC
                       (replaces the upstream `-m auto` whose interval is
                       hard-coded at 5 s and not configurable)
  MANAGER_MODE=smart   load-aware switching with hysteresis:
                       load >= BUSY_PCT -> cpu_usage, <= IDLE_PCT -> cpu_temp

Other keys: DWELL_SEC (10), BUSY_PCT (50), IDLE_PCT (25), POLL_SEC (2).

Runs as a user service; applies changes by rewriting
~/.config/deepcool-digital.conf (preserving -f/-a/-u flags) and
restarting the deepcool-digital user service.
"""
import os
import shlex
import subprocess
import sys
import time

CONF = os.path.expanduser("~/.config/deepcool-digital.conf")
ENV_FILE = os.path.expanduser("~/.config/deepcool-digital-manager.env")
UNIT = "deepcool-digital.service"

DEFAULTS = {
    "MANAGER_MODE": "smart",
    "DWELL_SEC": "10",
    "BUSY_PCT": "50",
    "IDLE_PCT": "25",
    "POLL_SEC": "2",
}


def load_cfg():
    cfg = dict(os.environ)
    try:
        for line in open(ENV_FILE):
            key, _, val = line.strip().partition("=")
            if key and not key.startswith("#"):
                cfg[key] = val
    except FileNotFoundError:
        pass
    return cfg


def cpu_times():
    """Return (idle_ticks, total_ticks) from /proc/stat."""
    with open("/proc/stat") as f:
        vals = [int(x) for x in f.readline().split()[1:]]
    idle = vals[3] + (vals[4] if len(vals) > 4 else 0)
    return idle, sum(vals)


def read_args():
    args = ["-m", "cpu_temp"]
    try:
        for line in open(CONF):
            if line.startswith("DEEPCOOL_ARGS="):
                raw = line.split("=", 1)[1].strip()
                if len(raw) >= 2 and raw[0] == raw[-1] and raw[0] in "\"'":
                    raw = raw[1:-1]
                args = raw.split()
                break
    except FileNotFoundError:
        pass
    return args


def current_mode():
    args = read_args()
    return args[args.index("-m") + 1] if "-m" in args else "cpu_temp"


def set_mode(mode):
    """Rewrite the conf with a new -m value, preserving other flags."""
    args = read_args()
    if "-m" in args:
        args[args.index("-m") + 1] = mode
    else:
        args = ["-m", mode] + args
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    with open(CONF, "w") as f:
        f.write("DEEPCOOL_ARGS=%s\n" % shlex.quote(" ".join(args)))
    subprocess.run(["systemctl", "--user", "restart", UNIT],
                   capture_output=True, text=True)


def smart_loop(busy, idle, poll):
    print("smart mode: load >= %g%% -> cpu_usage, load <= %g%% -> cpu_temp, poll %gs"
          % (busy, idle, poll), flush=True)
    prev = cpu_times()
    desired = current_mode()
    while True:
        time.sleep(poll)
        cur = cpu_times()
        d_idle, d_total = cur[0] - prev[0], cur[1] - prev[1]
        prev = cur
        if d_total <= 0:
            continue
        load = 100.0 * (1.0 - d_idle / d_total)
        new = None
        if load >= busy and desired != "cpu_usage":
            new = "cpu_usage"
        elif load <= idle and desired != "cpu_temp":
            new = "cpu_temp"
        if new:
            desired = new
            print("cpu load %.0f%% -> %s" % (load, new), flush=True)
            set_mode(new)


def auto_loop(dwell):
    """Alternate temp/usage with INSTANT transitions.

    Restarts of the deepcool-digital driver re-send the device init
    sequence, visibly re-initializing the screen. Instead, stop the
    driver and drive the hidraw device directly (protocol per upstream
    ak_series.rs): packets are [16, mode, bar, d1, d2, d3, alarm], with
    the SE variant shifting bytes left (no report ID). Mode switches are
    just different packet contents — no re-init, no flash.
    """
    import glob as _glob
    import signal

    # let the finally-handoff run when systemd stops us (SIGTERM would
    # otherwise kill the process without unwinding)
    def _term(_signum, _frame):
        raise SystemExit(0)
    signal.signal(signal.SIGTERM, _term)

    def find_hidraw():
        for h in sorted(_glob.glob("/sys/class/hidraw/*")):
            try:
                with open(h + "/device/uevent") as f:
                    if "0003:00003633" in f.read():
                        return "/dev/" + h.rsplit("/", 1)[1]
            except OSError:
                continue
        return None

    def read_temp_c():
        for hw in sorted(_glob.glob("/sys/class/hwmon/hwmon*")):
            try:
                with open(hw + "/name") as f:
                    if f.read().strip() != "k10temp":
                        continue
                for t in sorted(_glob.glob(hw + "/temp*_input")):
                    with open(t) as f:
                        return int(f.read().strip()) // 1000
            except OSError:
                continue
        return 0

    args = read_args()
    update_s = max(0.25, int(args[args.index("-u") + 1]) / 1000.0) if "-u" in args else 1.0
    fahrenheit = "-f" in args
    alarm = "-a" in args

    path = find_hidraw()
    if not path:
        print("auto mode: no DeepCool hidraw device found; "
              "falling back to restart-based switching", flush=True)
        auto_loop_restarts(dwell)
        return

    subprocess.run(["systemctl", "--user", "stop", UNIT], capture_output=True)
    fd = None

    def dev_write(payload):
        """hidraw writes need a leading 0x00 report ID for unnumbered
        reports (the hidapi/libusb backend the driver uses sends raw
        interrupt transfers without one)."""
        try:
            os.write(fd, b"\x00" + bytes(payload))
        except OSError:
            os.write(fd, bytes(payload))

    try:
        fd = os.open(path, os.O_WRONLY)
        # init sequence: [16, 170, ...] -> SE wire form [170, ...]
        init = bytearray(64)
        init[0], init[1] = 16, 170
        dev_write(init[1:])

        print("auto mode (direct): %s, alternating every %gs, update %.2fs"
              % (path, dwell, update_s), flush=True)
        mode = "cpu_temp"
        last_flip = time.monotonic()
        prev = cpu_times()
        usage = 0
        while True:
            time.sleep(update_s)
            cur = cpu_times()
            d_idle, d_total = cur[0] - prev[0], cur[1] - prev[1]
            prev = cur
            if d_total > 0:
                usage = min(100, int(100.0 * (1.0 - d_idle / d_total)))

            if time.monotonic() - last_flip >= dwell:
                mode = "cpu_usage" if mode == "cpu_temp" else "cpu_temp"
                last_flip = time.monotonic()

            temp = read_temp_c()
            if fahrenheit:
                temp = int(temp * 9 / 5 + 32)
            pkt = bytearray(64)
            pkt[0] = 16
            if mode == "cpu_temp":
                pkt[1] = 35 if fahrenheit else 19
                value = temp
            else:
                pkt[1] = 76
                value = usage
            pkt[2] = 1 if usage < 15 else int(round(usage / 10.0))
            pkt[3] = value // 100
            pkt[4] = value % 100 // 10
            pkt[5] = value % 10
            pkt[6] = 1 if (alarm and temp >= (194 if fahrenheit else 90)) else 0
            dev_write(pkt[1:])  # SE devices: no protocol prefix byte
    finally:
        if fd is not None:
            os.close(fd)
        # hand the display back to the driver
        subprocess.run(["systemctl", "--user", "start", UNIT], capture_output=True)


def auto_loop_restarts(dwell):
    modes = ["cpu_temp", "cpu_usage"]
    i = 0
    while True:
        mode = modes[i % 2]
        i += 1
        set_mode(mode)
        print("auto: showing %s for %gs (restart-based)" % (mode, dwell), flush=True)
        time.sleep(dwell)


def main():
    cfg = load_cfg()
    mode = cfg.get("MANAGER_MODE", DEFAULTS["MANAGER_MODE"]).lower()
    try:
        if mode == "auto":
            auto_loop(float(cfg.get("DWELL_SEC", DEFAULTS["DWELL_SEC"])))
        else:
            smart_loop(float(cfg.get("BUSY_PCT", DEFAULTS["BUSY_PCT"])),
                       float(cfg.get("IDLE_PCT", DEFAULTS["IDLE_PCT"])),
                       float(cfg.get("POLL_SEC", DEFAULTS["POLL_SEC"])))
    except KeyboardInterrupt:
        sys.exit(0)


if __name__ == "__main__":
    main()

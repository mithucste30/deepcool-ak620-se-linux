#!/usr/bin/env python3
"""DeepCool Digital — mode manager (smart / auto).

Two modes, configured via ~/.config/deepcool-digital-manager.env
(which overrides the unit's Environment= defaults):

  MANAGER_MODE=auto    alternate Temperature <-> CPU usage every DWELL_SEC
                       (replaces the upstream `-m auto` whose interval is
                       hard-coded at 5 s and not configurable)
  MANAGER_MODE=smart   load-aware switching with hysteresis:
                       load >= BUSY_PCT -> cpu_usage, <= IDLE_PCT -> cpu_temp

Other keys: DWELL_SEC (10), BUSY_PCT (50), IDLE_PCT (25), POLL_SEC (2).

Runs as a user service; applies changes by rewriting
~/.config/deepcool-digital.conf (preserving -f/-a/-u flags) and
restarting the deepcool-digital user service.
"""
import os
import shlex
import subprocess
import sys
import time

CONF = os.path.expanduser("~/.config/deepcool-digital.conf")
ENV_FILE = os.path.expanduser("~/.config/deepcool-digital-manager.env")
UNIT = "deepcool-digital.service"

DEFAULTS = {
    "MANAGER_MODE": "smart",
    "DWELL_SEC": "10",
    "BUSY_PCT": "50",
    "IDLE_PCT": "25",
    "POLL_SEC": "2",
}


def load_cfg():
    cfg = dict(os.environ)
    try:
        for line in open(ENV_FILE):
            key, _, val = line.strip().partition("=")
            if key and not key.startswith("#"):
                cfg[key] = val
    except FileNotFoundError:
        pass
    return cfg


def cpu_times():
    """Return (idle_ticks, total_ticks) from /proc/stat."""
    with open("/proc/stat") as f:
        vals = [int(x) for x in f.readline().split()[1:]]
    idle = vals[3] + (vals[4] if len(vals) > 4 else 0)
    return idle, sum(vals)


def read_args():
    args = ["-m", "cpu_temp"]
    try:
        for line in open(CONF):
            if line.startswith("DEEPCOOL_ARGS="):
                raw = line.split("=", 1)[1].strip()
                if len(raw) >= 2 and raw[0] == raw[-1] and raw[0] in "\"'":
                    raw = raw[1:-1]
                args = raw.split()
                break
    except FileNotFoundError:
        pass
    return args


def current_mode():
    args = read_args()
    return args[args.index("-m") + 1] if "-m" in args else "cpu_temp"


def set_mode(mode):
    """Rewrite the conf with a new -m value, preserving other flags."""
    args = read_args()
    if "-m" in args:
        args[args.index("-m") + 1] = mode
    else:
        args = ["-m", mode] + args
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    with open(CONF, "w") as f:
        f.write("DEEPCOOL_ARGS=%s\n" % shlex.quote(" ".join(args)))
    subprocess.run(["systemctl", "--user", "restart", UNIT],
                   capture_output=True, text=True)


def smart_loop(busy, idle, poll):
    print("smart mode: load >= %g%% -> cpu_usage, load <= %g%% -> cpu_temp, poll %gs"
          % (busy, idle, poll), flush=True)
    prev = cpu_times()
    desired = current_mode()
    while True:
        time.sleep(poll)
        cur = cpu_times()
        d_idle, d_total = cur[0] - prev[0], cur[1] - prev[1]
        prev = cur
        if d_total <= 0:
            continue
        load = 100.0 * (1.0 - d_idle / d_total)
        new = None
        if load >= busy and desired != "cpu_usage":
            new = "cpu_usage"
        elif load <= idle and desired != "cpu_temp":
            new = "cpu_temp"
        if new:
            desired = new
            print("cpu load %.0f%% -> %s" % (load, new), flush=True)
            set_mode(new)


def auto_loop(dwell):
    print("auto mode: alternating cpu_temp <-> cpu_usage every %gs" % dwell, flush=True)
    modes = ["cpu_temp", "cpu_usage"]
    i = 0
    while True:
        mode = modes[i % 2]
        i += 1
        set_mode(mode)
        print("auto: showing %s for %gs" % (mode, dwell), flush=True)
        time.sleep(dwell)


def main():
    cfg = load_cfg()
    mode = cfg.get("MANAGER_MODE", DEFAULTS["MANAGER_MODE"]).lower()
    try:
        if mode == "auto":
            auto_loop(float(cfg.get("DWELL_SEC", DEFAULTS["DWELL_SEC"])))
        else:
            smart_loop(float(cfg.get("BUSY_PCT", DEFAULTS["BUSY_PCT"])),
                       float(cfg.get("IDLE_PCT", DEFAULTS["IDLE_PCT"])),
                       float(cfg.get("POLL_SEC", DEFAULTS["POLL_SEC"])))
    except KeyboardInterrupt:
        sys.exit(0)


if __name__ == "__main__":
    main()

#!/usr/bin/env python3
"""DeepCool Digital — GUI controller for deepcool-digital-linux.

GTK3 + Ayatana AppIndicator: lives in the system tray, window close hides
to tray. Toggles the AK620 DIGITAL (SE) display between temperature /
usage / auto / smart (load-aware) instantly and without root by rewriting
~/.config/deepcool-digital.conf and restarting the *user* systemd service.
The system-wide service and the user service must not run at the same
time; the GUI detects that and offers a one-time takeover.
"""
import os
import shlex
import subprocess
import sys

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk

try:
    gi.require_version("AyatanaAppIndicator3", "0.1")
    from gi.repository import AyatanaAppIndicator3 as Ayatana
    HAVE_TRAY = True
except (ValueError, ImportError):
    HAVE_TRAY = False

UNIT = "deepcool-digital.service"
SMART_UNIT = "deepcool-digital-smart.service"
CONF_FILE = os.path.expanduser("~/.config/deepcool-digital.conf")
MANAGER_FILE = os.path.expanduser("~/.config/deepcool-digital-manager.env")
ICON = "deepcool-digital"
SYSTEM_AUTOSTART = "/etc/xdg/autostart/deepcool-digital-gui.desktop"
AUTOSTART_FILE = os.path.expanduser("~/.config/autostart/deepcool-digital-gui.desktop")

AUTOSTART_ENTRY = """[Desktop Entry]
Type=Application
Name=DeepCool Digital
Comment=Tray control for the DeepCool cooler display
Exec=/usr/bin/deepcool-digital-gui
Icon=deepcool-digital
Terminal=false
"""

MODES = [
    ("cpu_temp", "Temperature"),
    ("cpu_usage", "CPU usage"),
    ("auto", "Auto (alternate both)"),
    ("smart", "Smart (usage when busy)"),
]
INTERVALS = [250, 500, 1000, 2000]
DWELLS = [5, 10, 15, 30, 60]


def read_manager():
    cfg = {"MANAGER_MODE": "smart", "DWELL_SEC": "10"}
    if os.path.exists(MANAGER_FILE):
        for line in open(MANAGER_FILE):
            key, _, val = line.strip().partition("=")
            if key and not key.startswith("#"):
                cfg[key] = val
    return cfg


def write_manager(cfg):
    os.makedirs(os.path.dirname(MANAGER_FILE), exist_ok=True)
    with open(MANAGER_FILE, "w") as f:
        for key, val in cfg.items():
            f.write("%s=%s\n" % (key, val))


def manager_mode():
    return read_manager().get("MANAGER_MODE", "smart")


def read_conf():
    state = {"mode": "cpu_temp", "f": False, "a": False, "u": 1000}
    if os.path.exists(CONF_FILE):
        for line in open(CONF_FILE):
            if line.startswith("DEEPCOOL_ARGS="):
                raw = line.split("=", 1)[1].strip()
                if len(raw) >= 2 and raw[0] == raw[-1] and raw[0] in "\"'":
                    raw = raw[1:-1]
                args = raw.split()
                if "-m" in args and args.index("-m") + 1 < len(args):
                    state["mode"] = args[args.index("-m") + 1]
                state["f"] = "-f" in args
                state["a"] = "-a" in args
                if "-u" in args and args.index("-u") + 1 < len(args) and args[args.index("-u") + 1].isdigit():
                    state["u"] = int(args[args.index("-u") + 1])
                break
    return state


def write_conf(state):
    args = ["-m", state["mode"]]
    if state["f"]:
        args.append("-f")
    if state["a"]:
        args.append("-a")
    args += ["-u", str(state["u"])]
    os.makedirs(os.path.dirname(CONF_FILE), exist_ok=True)
    with open(CONF_FILE, "w") as f:
        f.write("DEEPCOOL_ARGS=%s\n" % shlex.quote(" ".join(args)))


def run(cmd):
    return subprocess.run(cmd, capture_output=True, text=True)


def system_service_active():
    return run(["systemctl", "is-active", "--quiet", UNIT]).returncode == 0


def smart_active():
    return run(["systemctl", "--user", "is-active", "--quiet", SMART_UNIT]).returncode == 0


def autostart_state():
    """User override file decides; otherwise default to the packaged entry."""
    if os.path.exists(AUTOSTART_FILE):
        for line in open(AUTOSTART_FILE):
            key, _, val = line.strip().partition("=")
            if key.strip().lower() == "hidden":
                return val.strip().lower() not in ("true", "1")
        return True
    return os.path.exists(SYSTEM_AUTOSTART)


def set_autostart(enabled):
    if enabled and os.path.exists(SYSTEM_AUTOSTART):
        # drop the user override; the packaged system entry applies
        try:
            os.remove(AUTOSTART_FILE)
        except FileNotFoundError:
            pass
        return
    os.makedirs(os.path.dirname(AUTOSTART_FILE), exist_ok=True)
    with open(AUTOSTART_FILE, "w") as f:
        f.write(AUTOSTART_ENTRY)
        f.write("X-GNOME-Autostart-enabled=%s\n" % ("true" if enabled else "false"))
        if not enabled:
            f.write("Hidden=true\n")


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.deepcool.digital.gui")
        self.state = read_conf()
        self.state["dwell"] = int(read_manager().get("DWELL_SEC", "10"))
        self.locked = False
        self.window = None
        self.tray_menu_items = {}

    # ---------------- application lifecycle ----------------

    def do_activate(self):
        if self.window is None:
            self.build_window()
            self.build_tray()
        self.window.show_all()
        Gtk.Application.do_activate(self)

    def build_window(self):
        win = Gtk.ApplicationWindow(application=self, title="DeepCool Digital")
        win.set_default_size(360, 480)
        win.set_icon_name(ICON)
        # close button hides to tray instead of quitting
        win.connect("delete-event", self.on_window_close)
        self.window = win

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.set_margin_top(16); box.set_margin_bottom(16)
        box.set_margin_start(16); box.set_margin_end(16)
        win.add(box)

        # --- warning banner if the system service is also running ---
        self.banner = Gtk.Label()
        self.banner.set_no_show_all(True)
        self.banner.set_line_wrap(True)
        box.add(self.banner)
        self.takeover_btn = Gtk.Button(label="Take over (disable system service)")
        self.takeover_btn.set_no_show_all(True)
        self.takeover_btn.connect("clicked", self.on_takeover)
        box.add(self.takeover_btn)

        # --- display mode ---
        mode_frame = Gtk.Frame(label=" Display mode ")
        mode_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        mode_box.set_margin_top(8); mode_box.set_margin_bottom(8)
        mode_box.set_margin_start(12); mode_box.set_margin_end(12)
        mode_frame.add(mode_box)
        box.add(mode_frame)

        self.mode_btns = {}
        group = None
        for value, label in MODES:
            btn = Gtk.RadioButton(label=label, group=group)
            btn.connect("toggled", self.on_mode_toggled, value)
            mode_box.add(btn)
            self.mode_btns[value] = btn
            group = group or btn

        # --- options ---
        opt_frame = Gtk.Frame(label=" Options ")
        opt_grid = Gtk.Grid(column_spacing=12, row_spacing=10)
        opt_grid.set_margin_top(8); opt_grid.set_margin_bottom(8)
        opt_grid.set_margin_start(12); opt_grid.set_margin_end(12)
        opt_frame.add(opt_grid)
        box.add(opt_frame)

        self.f_btn = Gtk.CheckButton(label="Fahrenheit (°F)")
        self.f_btn.connect("toggled", self.on_option, "f")
        opt_grid.attach(self.f_btn, 0, 0, 1, 1)

        self.a_btn = Gtk.CheckButton(label="Temperature alarm")
        self.a_btn.connect("toggled", self.on_option, "a")
        opt_grid.attach(self.a_btn, 0, 1, 1, 1)

        lbl = Gtk.Label(label="Update interval")
        lbl.set_halign(Gtk.Align.START)
        opt_grid.attach(lbl, 0, 2, 1, 1)
        self.u_dd = Gtk.ComboBoxText()
        for i in INTERVALS:
            self.u_dd.append_text("%d ms" % i)
        self.u_dd.connect("changed", self.on_interval)
        opt_grid.attach(self.u_dd, 1, 2, 1, 1)

        dlbl = Gtk.Label(label="Auto: switch every")
        dlbl.set_halign(Gtk.Align.START)
        opt_grid.attach(dlbl, 0, 3, 1, 1)
        self.dwell_dd = Gtk.ComboBoxText()
        for d in DWELLS:
            self.dwell_dd.append_text("%d s" % d)
        self.dwell_dd.connect("changed", self.on_dwell)
        opt_grid.attach(self.dwell_dd, 1, 3, 1, 1)

        self.start_btn = Gtk.CheckButton(label="Start at login (system tray)")
        self.start_btn.connect("toggled", self.on_autostart)
        opt_grid.attach(self.start_btn, 0, 4, 2, 1)

        # --- status + note ---
        self.status = Gtk.Label()
        self.status.set_line_wrap(True)
        box.add(self.status)

        note = Gtk.Label(label="Changes apply instantly. Closing this window keeps "
                               "the display running; use the tray icon to reopen.")
        note.set_line_wrap(True)
        note.set_halign(Gtk.Align.START)
        note.get_style_context().add_class("dim-label")
        box.add(note)

        self.sync_widgets()
        self.refresh_banner()

    # ---------------- tray ----------------

    def build_tray(self):
        self.tray_menu_items = {}
        if not HAVE_TRAY:
            return
        menu = Gtk.Menu()
        item = Gtk.MenuItem(label="Open DeepCool Digital")
        item.connect("activate", lambda *_: self.toggle_window())
        menu.append(item)
        menu.append(Gtk.SeparatorMenuItem())

        group = None
        for value, label in MODES:
            if group is None:
                mitem = Gtk.RadioMenuItem(label=label)
            else:
                mitem = Gtk.RadioMenuItem.new_with_label_from_widget(group, label)
            menu.append(mitem)
            self.tray_menu_items[value] = mitem
            group = group or mitem
        # connect handlers only after all groups are set, so set_group's
        # internal signal emissions don't fire mode changes at startup
        for value, mitem in self.tray_menu_items.items():
            mitem.connect("toggled", self.on_mode_toggled, value)

        menu.append(Gtk.SeparatorMenuItem())
        quit_item = Gtk.MenuItem(label="Quit")
        quit_item.connect("activate", lambda *_: self.quit())
        menu.append(quit_item)
        menu.show_all()

        self.indicator = Ayatana.Indicator.new(
            "deepcool-digital", ICON, Ayatana.IndicatorCategory.APPLICATION_STATUS)
        self.indicator.set_status(Ayatana.IndicatorStatus.ACTIVE)
        self.indicator.set_title("DeepCool Digital")
        self.indicator.set_menu(menu)
        try:
            # left-click toggles the window where the backend provides the
            # signal; otherwise clicking the icon opens the menu
            self.indicator.connect("activate", lambda *_: self.toggle_window())
        except TypeError:
            pass
        self.sync_widgets()

    def toggle_window(self):
        if self.window.get_visible():
            self.window.hide()
        else:
            self.window.show_all()
            self.present()

    # ---------------- helpers ----------------

    def sync_widgets(self):
        self.locked = True
        mgr_on = smart_active()
        mgr_mode = manager_mode()
        for value, btn in self.mode_btns.items():
            btn.set_active(self.radio_state(value, mgr_on, mgr_mode))
        for value, mitem in self.tray_menu_items.items():
            mitem.set_active(self.radio_state(value, mgr_on, mgr_mode))
        self.f_btn.set_active(self.state["f"])
        self.a_btn.set_active(self.state["a"])
        self.u_dd.set_active(INTERVALS.index(self.state["u"]) if self.state["u"] in INTERVALS else 2)
        self.dwell_dd.set_active(DWELLS.index(self.state["dwell"]) if self.state["dwell"] in DWELLS else 1)
        self.start_btn.set_active(autostart_state())
        self.locked = False
        self.update_status()

    def radio_state(self, value, mgr_on, mgr_mode):
        if mgr_on:
            return value == mgr_mode  # smart or auto managed by the manager
        return self.state["mode"] == value  # plain conf mode

    def choose_mode(self, value):
        """Single entry point for mode selection (window radios + tray menu)."""
        if value in ("smart", "auto"):
            cfg = read_manager()
            cfg["MANAGER_MODE"] = value
            if value == "auto":
                cfg["DWELL_SEC"] = str(self.state["dwell"])
            write_manager(cfg)
            run(["systemctl", "--user", "enable", SMART_UNIT])
            run(["systemctl", "--user", "restart", SMART_UNIT])
        else:
            run(["systemctl", "--user", "disable", "--now", SMART_UNIT])
            self.state["mode"] = value
            self.apply()
        self.sync_widgets()

    def apply(self):
        write_conf(self.state)
        run(["systemctl", "--user", "enable", UNIT])
        run(["systemctl", "--user", "restart", UNIT])

    def update_status(self):
        r = run(["systemctl", "--user", "is-active", UNIT])
        mode = dict(MODES)[self.state["mode"]]
        unit = "°F" if self.state["f"] else "°C"
        prefix = "● Running" if r.stdout.strip() == "active" else "○ Not running"
        extra = ""
        if smart_active():
            if manager_mode() == "auto":
                extra = " — Auto: switching every %d s" % self.state["dwell"]
            else:
                extra = " — Smart: switching by CPU load"
        self.status.set_markup("<b>%s</b> — %s (%s), %d ms%s" % (prefix, mode, unit, self.state["u"], extra))

    def refresh_banner(self):
        conflict = system_service_active()
        self.banner.set_visible(conflict)
        self.takeover_btn.set_visible(conflict)
        if conflict:
            self.banner.set_markup("<b>System service is running too.</b>\n"
                                   "Both services write to the display; let your session manage it.")

    # ---------------- callbacks ----------------

    def on_window_close(self, *_):
        if HAVE_TRAY:
            self.window.hide()
            return True  # block destroy; app keeps running in tray
        return False

    def on_mode_toggled(self, btn, value):
        if not self.locked and btn.get_active():
            self.choose_mode(value)

    def on_option(self, btn, key):
        if self.locked:
            return
        self.state[key] = btn.get_active()
        self.apply()
        self.update_status()

    def on_interval(self, _dd):
        if self.locked:
            return
        self.state["u"] = INTERVALS[self.u_dd.get_active()]
        self.apply()
        self.update_status()

    def on_autostart(self, btn):
        if self.locked:
            return
        set_autostart(btn.get_active())

    def on_dwell(self, _dd):
        if self.locked:
            return
        self.state["dwell"] = DWELLS[self.dwell_dd.get_active()]
        cfg = read_manager()
        cfg["DWELL_SEC"] = str(self.state["dwell"])
        write_manager(cfg)
        if smart_active() and manager_mode() == "auto":
            run(["systemctl", "--user", "restart", SMART_UNIT])
        self.update_status()

    def on_takeover(self, _btn):
        self.takeover_btn.set_sensitive(False)
        r = subprocess.run(["pkexec", "systemctl", "disable", "--now", UNIT],
                           capture_output=True, text=True)
        if r.returncode == 0:
            self.apply()
        else:
            self.status.set_text("Takeover failed: %s" % (r.stderr.strip() or "cancelled"))
        self.takeover_btn.set_sensitive(True)
        self.refresh_banner()


if __name__ == "__main__":
    app = App()
    app.run(sys.argv)
